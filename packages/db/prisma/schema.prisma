// Project Management domain — multi-tenant (Organization = tenant).
// Conventions: UUIDv7 ids, snake_case tables/columns, soft delete via deleted_at,
// every mutation recorded in audit_logs.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  projects    Project[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

/// Identity key = office email (future OIDC / IDS subject mapped via external_id).
model User {
  id         String   @id @default(uuid(7)) @db.Uuid
  email      String   @unique
  name       String
  externalId String?  @unique @map("external_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    Membership[]
  ownedProjects  Project[]   @relation("ProjectOwner")
  assignedTasks  Task[]      @relation("TaskAssignee")
  reportedTasks  Task[]      @relation("TaskReporter")
  comments       Comment[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Project {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Short human key, e.g. "DG" → tasks DG-1, DG-2 …
  key            String
  name           String
  description    String?
  status         ProjectStatus @default(PLANNED)
  ownerId        String?       @map("owner_id") @db.Uuid
  startDate      DateTime?     @map("start_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  /// Monotonic counter for task numbers within the project.
  taskSeq        Int           @default(0) @map("task_seq")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  number      Int
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @map("assignee_id") @db.Uuid
  reporterId  String?      @map("reporter_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  dueDate     DateTime?    @map("due_date") @db.Date
  sortOrder   Float        @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User?     @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent   Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks Task[]    @relation("Subtasks")
  comments Comment[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("comments")
}

/// Append-only. Who did what to which entity, with a JSON snapshot of the change.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  data           Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
