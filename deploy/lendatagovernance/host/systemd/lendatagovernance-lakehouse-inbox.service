[Unit]
Description=Len Data Governance: muat berkas inbox ke Trino lakehouse (Bronze -> Silver -> Gold)
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
Environment=LDG_DATA_DIR=/srv/lendatagovernance
ExecStart=/srv/lendatagovernance/medallion/.venv/bin/python -u /opt/lendatagovernance/deploy/medallion/lakehouse.py inbox
StandardOutput=append:/srv/lendatagovernance/medallion/logs/inbox.log
StandardError=append:/srv/lendatagovernance/medallion/logs/inbox.log
