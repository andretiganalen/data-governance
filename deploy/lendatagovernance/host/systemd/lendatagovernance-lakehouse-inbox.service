[Unit]
Description=Len Data Governance: muat berkas inbox ke Trino lakehouse (Bronze -> Silver -> Gold)
After=network-online.target
[Service]
Type=oneshot
TimeoutStartSec=30min
User=ubuntu
Environment=LDG_DATA_DIR=/home/ubuntu/data-governance/data
# Sinkron folder sumber Nextcloud (DBASTACITA) ke inbox dulu; gagal (mis. kredensial belum ada) tidak menghentikan pemuatan.
ExecStartPre=-/home/ubuntu/data-governance/data/medallion/.venv/bin/python -u /home/ubuntu/data-governance/deploy/lendatagovernance/medallion/nextcloud_sync.py
ExecStart=/home/ubuntu/data-governance/data/medallion/.venv/bin/python -u /home/ubuntu/data-governance/deploy/lendatagovernance/medallion/lakehouse.py inbox
StandardOutput=append:/home/ubuntu/data-governance/data/medallion/logs/inbox.log
StandardError=append:/home/ubuntu/data-governance/data/medallion/logs/inbox.log
