[Unit]
Description=Len Data Governance: ambil ulang ERM + SDM dari replika CDC LenoDB bila berubah (Bronze -> Silver -> Gold) + kesegaran data
After=network-online.target
[Service]
Type=oneshot
TimeoutStartSec=14min
User=ubuntu
Environment=LDG_DATA_DIR=/home/ubuntu/data-governance/data
ExecStart=/home/ubuntu/data-governance/data/medallion/.venv/bin/python -u /home/ubuntu/data-governance/deploy/lendatagovernance/medallion/lakehouse.py cdc
StandardOutput=append:/home/ubuntu/data-governance/data/medallion/logs/cdc.log
StandardError=append:/home/ubuntu/data-governance/data/medallion/logs/cdc.log
