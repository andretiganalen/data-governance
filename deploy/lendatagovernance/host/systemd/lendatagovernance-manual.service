[Unit]
Description=Len Data Governance: rilis manual mingguan (3 PDF + daftar Master Organisasi)
After=network-online.target
[Service]
Type=oneshot
TimeoutStartSec=90min
User=ubuntu
Environment=LDG_DATA_DIR=/home/ubuntu/data-governance/data
ExecStart=/home/ubuntu/data-governance/deploy/lendatagovernance/scripts/rilis-mingguan.sh
StandardOutput=append:/home/ubuntu/data-governance/data/medallion/logs/manual.log
StandardError=append:/home/ubuntu/data-governance/data/medallion/logs/manual.log
