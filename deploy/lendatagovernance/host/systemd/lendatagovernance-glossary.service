[Unit]
Description=Len Data Governance: catat Glosarium aplikasi ke Trino (gold_meta_glossary)
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
Environment=LDG_DATA_DIR=/home/ubuntu/data-governance/data
ExecStart=/home/ubuntu/data-governance/data/medallion/.venv/bin/python -u /home/ubuntu/data-governance/deploy/lendatagovernance/medallion/lakehouse.py glossary
StandardOutput=append:/home/ubuntu/data-governance/data/medallion/logs/glossary.log
StandardError=append:/home/ubuntu/data-governance/data/medallion/logs/glossary.log
