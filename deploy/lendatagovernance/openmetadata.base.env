# Non-secret OpenMetadata settings (variable names from conf/openmetadata.yaml @ 2.0.7-release).
# Secrets and IDS client values: /srv/lendatagovernance/secrets/openmetadata.env
OPENMETADATA_CLUSTER_NAME=openmetadata
SERVER_PORT=8585
SERVER_ADMIN_PORT=8586
LOG_LEVEL=INFO
OPENMETADATA_HEAP_OPTS=-Xmx1536m -Xms1536m
OPENMETADATA_SERVER_URL=http://192.168.125.14

# Database
DB_DRIVER_CLASS=org.postgresql.Driver
DB_SCHEME=postgresql
DB_PARAMS=allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_HOST=postgresql
DB_PORT=5432
DB_USER=openmetadata_user
OM_DATABASE=openmetadata_db

# Search (OpenSearch, Apache-2.0)
SEARCH_TYPE=opensearch
ELASTICSEARCH_HOST=opensearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# No Airflow: ingestion runs via our own scripts (phase 3)
PIPELINE_SERVICE_CLIENT_ENABLED=false

# Authorization
AUTHORIZER_CLASS_NAME=org.openmetadata.service.security.DefaultAuthorizer
AUTHORIZER_REQUEST_FILTER=org.openmetadata.service.security.JwtFilter
AUTHORIZER_PRINCIPAL_DOMAIN=len.co.id
AUTHORIZER_ENFORCE_PRINCIPAL_DOMAIN=false
AUTHORIZER_INGESTION_PRINCIPALS=[ingestion-bot]

# JWT signing keys generated per-server (scripts/secrets-init.sh)
RSA_PUBLIC_KEY_FILE_PATH=./conf/jwt/public_key.der
RSA_PRIVATE_KEY_FILE_PATH=./conf/jwt/private_key.der
JWT_ISSUER=dev-data.len.co.id

SECRET_MANAGER=db
EVENT_MONITOR=prometheus
