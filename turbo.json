{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DATABASE_URL", "NODE_ENV"],
  "tasks": {
    "generate": { "cache": false },
    "build": { "dependsOn": ["^build", "^generate"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "dependsOn": ["^generate"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^generate"] },
    "typecheck": { "dependsOn": ["^generate"] },
    "test": { "dependsOn": ["^generate"] }
  }
}
